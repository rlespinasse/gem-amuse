{
  "private": true,
  "type": "module",
  "name": "gem-amuse",
  "description": "Gem'Amuse — Des Gems Google Gemini créées pour les enfants : coloriages, science, défis rigolos et chasses aux trésors",
  "scripts": {
    "dev": "browser-sync start --server site --serveStatic site --files 'site/**/*' --no-notify --index 404.html",
    "lint:html": "htmlhint site/**/*.html",
    "lint:css": "stylelint site/**/*.css",
    "lint:css:fix": "stylelint site/**/*.css --fix",
    "lint:js": "eslint site/**/*.js",
    "lint:js:fix": "eslint site/**/*.js --fix",
    "lint:md": "markdownlint-cli2 '**/*.md' '#node_modules'",
    "lint:md:fix": "markdownlint-cli2 '**/*.md' '#node_modules' --fix",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js && npm run lint:md",
    "lint:fix": "npm run lint:css:fix && npm run lint:js:fix && npm run lint:md:fix",
    "generate:favicons": "node scripts/generate-favicons.js",
    "update:gem": "node scripts/update-gem-url.js",
    "check:gem": "node --max-http-header-size=65536 scripts/check-gem-url.js"
  },
  "devDependencies": {
    "browser-sync": "^3.0.0",
    "eslint": "^10.8.0",
    "htmlhint": "^1.1.0",
    "markdownlint-cli2": "^0.23.1",
    "sharp": "^0.35.3",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0"
  },
  "overrides": {
    "browser-sync": {
      "immutable": "^4.3.9"
    },
    "browser-sync-ui": {
      "immutable": "^4.3.9"
    },
    "markdownlint-cli2": {
      "js-yaml": "^5.2.2"
    }
  }
}
